# Copie para .env e preencha. O .env está no .gitignore: nunca versione segredos.

# Provedor de LLM: gemini (padrão) ou anthropic
LLM_PROVIDER=gemini
# Chave do provedor escolhido (só a do provedor ativo é necessária)
GEMINI_API_KEY=<sua-chave-gemini>
# ANTHROPIC_API_KEY=<sua-chave-anthropic>

# Modelos (opcional). Vazio = padrão do provedor:
#   gemini:    LLM_MODEL=gemini-3.8-flash   LLM_MODEL_ORQUESTRADOR=gemini-3.5-flash-lite
#   anthropic: LLM_MODEL=claude-sonnet-5-5  LLM_MODEL_ORQUESTRADOR=claude-haiku-5-5
LLM_MODEL=
LLM_MODEL_ORQUESTRADOR=
# Tentativas por chamada ao Gemini em erros transitórios (429/5xx)
LLM_TENTATIVAS=4
# Só Anthropic: fallback do servidor em recusas (default | off)
LLM_FALLBACK=default

# Banco local de desenvolvimento
POSTGRES_DB=areco
POSTGRES_USER=areco
POSTGRES_PASSWORD=<defina-uma-senha>
# Usado ao rodar fora do Docker (testes/scripts locais)
DATABASE_URL=postgresql://areco:<mesma-senha>@localhost:5432/areco

# Ajustes opcionais
LIMIAR_CONFIANCA=0.6
LIMIAR_SIMILARIDADE=0.40
RAG_TOP_K=4
